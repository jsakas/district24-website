---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import { ExtLink } from '../components/ExtLink';
import { EventsTable } from '../components/EventsTable';
import { SERVICE_POSITIONS } from '../data';
---
<BaseLayout description="Alcoholics Anonymous in District 24 (Ozaukee County), Area 75 Southern Wisconsin: meetings, events, workshops and service information.">
  <div class="page">
    <div class="hero">
      <div class="hero__orb1"></div>
      <div class="hero__orb2"></div>
      <h1 class="hero__h1">AA in District 24</h1>
      <p class="hero__sub">Ozaukee County · Area 75 (Southern Wisconsin)</p>
    </div>

    <Card title="Who Are We?">
      <p class="page-p">
        This website is for <strong>District 24</strong> (Ozaukee County), part of <strong>Area 75</strong> (Southern Wisconsin).
        An A.A. <em>District</em> is part of the overall structure of Alcoholics Anonymous.{' '}
        <ExtLink href="https://mtg.area75.org/thestructure.html">Learn more about the structure of A.A.</ExtLink>
      </p>
      <p class="page-p">There are over fifty groups and two clubs in our District.</p>
    </Card>

    <Card title="Purpose of This Website">
      <p class="page-p">
        The purpose of this website is to help the still suffering alcoholic by carrying the message of recovery through
        Alcoholics Anonymous to the general public and to provide information regarding events, meetings, workshops,
        conferences, and other matters of importance to recovering alcoholics in District 24. The guiding principles are
        taken from the A.A. Preamble, the Twelve Steps and Twelve Traditions, and other A.A. General Service Conference
        approved literature.
      </p>
    </Card>

    <Card title="Upcoming Events">
      <EventsTable client:load />
    </Card>

    <div class="two-col">
      <Card class="card--accent-yellow">
        <h2 class="card__h2">⭐ Featured Meeting</h2>
        <p class="page-p semibold">Saukville Big Book Meeting (65294)</p>
        <p class="page-p">
          Living Hope Lutheran Church<br />
          851 W Dekora St<br />
          Saukville, WI 53080<br />
          <em>Enter off Hwy 33</em>
        </p>
        <p class="page-p"><strong>Thursday 7:00 PM</strong></p>
      </Card>
      <Card class="card--accent-top">
        <h2 class="card__h2">📅 District 24 Monthly Meetings</h2>
        <p class="page-p"><strong>When:</strong> 3rd Tuesday of every month <em>(except December)</em></p>
        <p class="page-p"><strong>Time:</strong> 6:30 PM – approx. 60–70 minutes</p>
        <p class="page-p">
          <strong>Where:</strong><br />
          Grace 242 Church<br />
          249 Main Street<br />
          Thiensville, WI 53092
        </p>
      </Card>
    </div>

    <Card title="District 24 Service Positions">
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Position</th><th>Contact</th><th>Term</th></tr>
          </thead>
          <tbody>
            {SERVICE_POSITIONS.map((r, i) => (
              <tr class={i % 2 === 0 ? 'stripe' : 'white'}>
                <td><strong>{r.pos}</strong></td>
                <td>{r.email ? <a href={`mailto:${r.email}`} class="inline-link">{r.name}</a> : r.name}</td>
                <td class="text-muted text-sm">{r.term}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    <Card class="card--tinted">
      <p>
        Questions about District 24, Area 75, or A.A.?
        Contact us at{' '}
        <a href="mailto:info@aadistrict24.org" class="inline-link bold">info@aadistrict24.org</a>
      </p>
    </Card>
    <br />
    <p class="centered">
      <span class="text-navy bold italic">Open District 24 <a target="_blank" rel="noopener noreferrer" href="https://drive.google.com/file/d/1qmuSAf2tNNXkwAtQ-qxsV0cCPpA1RYBw/view">'When and Where'</a>&nbsp;(Meeting Directory)</span>
    </p>
  </div>
</BaseLayout>
