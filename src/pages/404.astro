---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
---
<BaseLayout title="Page Not Found" description="The page you were looking for could not be found.">
  <div class="page">
    <h1 class="page-h1">Page Not Found</h1>
    <Card>
      <p class="page-p">Sorry, we couldn't find that page. <a href="/" class="inline-link">Return to the home page</a>.</p>
    </Card>
  </div>
</BaseLayout>
